# FastAPI Service Host & Port
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Supabase PostgreSQL Database URL
# Format: postgresql+psycopg2://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Direct connection (port 5432): postgresql+psycopg2://postgres:[YOUR_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=postgresql+psycopg2://postgres.wsmvrxnmyfrggkunihro:[YOUR_DATABASE_PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Supabase Project Credentials (Found in Supabase Dashboard > Settings > API)
SUPABASE_URL=https://wsmvrxnmyfrggkunihro.supabase.co
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
