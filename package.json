{
  "name": "scripture-notes-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "ScriptureNotes - Monorepo with Next.js Frontend & Python FastAPI Backend",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "python backend/run.py",
